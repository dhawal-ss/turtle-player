    <!-- Moves -->
    <string name="shell_dj_move_blend">Blend</string>
    <string name="shell_dj_move_blend_body">Both tracks play together, then the bass swaps over.</string>
    <string name="shell_dj_move_filter">Filter fade</string>
    <string name="shell_dj_move_filter_body">The old track sinks under a filter as the new one opens up.</string>
    <string name="shell_dj_move_echo">Echo out</string>
    <string name="shell_dj_move_echo_body">The old track echoes away and the new one drops on the beat.</string>
    <string name="shell_dj_move_cut">Cut</string>
    <string name="shell_dj_move_cut_body">A clean switch, right on the downbeat.</string>
    <string name="shell_dj_move_spin">Spinback</string>
    <string name="shell_dj_move_spin_body">The record spins back and the next track slams in.</string>
    <string name="shell_dj_move_brake">Brake</string>
    <string name="shell_dj_move_brake_body">The old track slows to a stop like a turntable switched off.</string>
    <string name="shell_dj_move_riser">Riser drop</string>
    <string name="shell_dj_move_riser_body">A riser builds the tension, then the new track drops.</string>
    <string name="shell_dj_move_roll">Loop roll</string>
    <string name="shell_dj_move_roll_body">The last beat repeats faster and faster, then the drop.</string>
